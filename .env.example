# Copy to .env for `netlify dev`; set the same names in the Netlify UI for deploys.

# --- DigitalOcean Spaces (images, feedback, knowledge base, model) ---
MY_AWS_ACCESS_KEY_ID=your_access_key_here
MY_AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Optional overrides (defaults shown). Read by netlify/functions/shared/storage-config.js
# SPACES_BUCKET=bengijzel
# SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
# SPACES_REGION=us-east-1
# SPACES_PUBLIC_URL=https://bengijzel.ams3.digitaloceanspaces.com

# --- Presets (Strapi, until the VAMS migration) ---
# Token the browser must present (?access=... or this public runtime value) to call
# the presets and upload functions. There is no built-in fallback any more.
PRESET_ACCESS_TOKEN=choose_a_long_random_string
NUXT_PUBLIC_PRESET_ACCESS_TOKEN=choose_a_long_random_string
# Server-side token the presets function uses to talk to Strapi
PRESET_CREATION_TOKEN=your_strapi_api_token

# --- CMS source (v2: VAMS) ---
# Unset/strapi = read presets from Strapi (v1 default). "vams" = read presets
# from VAMS instead (read-only for now; writes return 501 until the VAMS write
# API exists). The access-token gate above still applies to the function.
# CMS_SOURCE=vams
# VAMS_API_KEY=itamar_vams_api_key   # the api_key on itamar@gilboa.net in VAMS
# VAMS_BASE_URL=https://app.use-vams.me

# --- Logging ---
# DEBUG_LEVEL=info   # error | warn | info | debug | verbose
